---
import Nav from '../components/Nav.astro';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import {
  APP_STORE_RATING,
  APP_STORE_REVIEW_COUNT,
  APP_STORE_URL,
  DEFAULT_DESCRIPTION,
  DEFAULT_KEYWORDS,
  PRO_MONTHLY_PRICE,
  PRO_YEARLY_PRICE,
} from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  path?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
}

const {
  title = 'LaunchBuddy — App Store Connect & AI Release Manager for Indie Devs',
  description = DEFAULT_DESCRIPTION,
  keywords = DEFAULT_KEYWORDS,
  path = '/',
  ogType = 'website',
  jsonLd,
  preloadImage,
} = Astro.props;

const canonicalUrl = new URL(path, Astro.site);
const ogImage = new URL('/images/preview.png', Astro.site).href;

const defaultJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LaunchBuddy',
    description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'iOS, macOS',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: APP_STORE_RATING,
      bestRating: '5',
      ratingCount: String(APP_STORE_REVIEW_COUNT),
    },
    url: 'https://launchbuddy.app',
    downloadUrl: APP_STORE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is LaunchBuddy free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Yes, LaunchBuddy is free to download and use. Pro features are available from ${PRO_MONTHLY_PRICE}/month or ${PRO_YEARLY_PRICE}/year.`,
        },
      },
      {
        '@type': 'Question',
        name: 'Is the iOS app included if I subscribe on the Mac?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, your subscription covers both the macOS and iOS versions of LaunchBuddy.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I suggest features?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, you can suggest features via the roadmap directly in LaunchBuddy.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does my data sync between iOS and macOS?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, all your data syncs seamlessly between devices via iCloud.',
        },
      },
    ],
  },
];

const structuredData = jsonLd ?? defaultJsonLd;
const jsonLdItems = Array.isArray(structuredData) ? structuredData : [structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="apple-itunes-app" content="app-id=1615169630" />
    <link rel="canonical" href={canonicalUrl.href} />

    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LaunchBuddy_App" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="LaunchBuddy iOS app release manager dashboard" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="LaunchBuddy iOS app release manager dashboard" />
    <meta property="og:url" content={canonicalUrl.href} />

    <link rel="icon" type="image/x-icon" href="/icon.ico" />
    <link rel="alternate" type="application/rss+xml" title="LaunchBuddy Blog" href="/rss.xml" />

    {
      jsonLdItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>

  <body class="font-body leading-normal tracking-normal text-text-secondary min-h-screen antialiased">
    <div class="bg-scene" aria-hidden="true">
      <div class="bg-scene__mesh"></div>
      <div class="bg-scene__orb bg-scene__orb--1"></div>
      <div class="bg-scene__orb bg-scene__orb--2"></div>
      <div class="bg-scene__orb bg-scene__orb--3"></div>
      <div class="bg-scene__grid"></div>
      <div class="bg-scene__noise"></div>
    </div>

    <div class="relative z-10">
      <Nav currentPath={path} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
