---
import '../styles/kit-form.css';

interface Props {
  uid: string;
  class?: string;
}

const { uid, class: className = '' } = Astro.props;
---

<div class:list={['kit-form', className]}>
  <script is:inline async data-uid={uid} src={`https://flowritescode.kit.com/${uid}/index.js`}></script>
</div>
