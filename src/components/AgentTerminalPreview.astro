---
const checklist = [
  { label: '4 of 6 checklist items done', done: true },
  { label: 'Fix offline sync', done: false },
  { label: 'Update App Store screenshots', done: false },
];
---

<div
  class="agent-terminal"
  role="img"
  aria-label="A coding agent asks LaunchBuddy what is left before version 2.4 ships, then waits for approval before marking a task done"
>
  <div class="agent-terminal__window">
    <div class="agent-terminal__bar">
      <span class="agent-terminal__lights"><span></span><span></span><span></span></span>
      <span class="agent-terminal__title">agent — orbit-notes</span>
    </div>
    <div class="agent-terminal__body">
      <p class="agent-terminal__prompt">› What's left before 2.4 ships?</p>
      <p class="agent-terminal__tool">
        <span class="agent-terminal__dot"></span>
        <span>LaunchBuddy <b>Get Next Release</b></span>
        <span class="agent-terminal__result">✓ 2.4</span>
      </p>
      <p class="agent-terminal__tool">
        <span class="agent-terminal__dot"></span>
        <span>LaunchBuddy <b>Get Release Status</b></span>
        <span class="agent-terminal__result">✓ done</span>
      </p>
      <div class="agent-terminal__output">
        <p><b>2.4 Shared Notebooks</b> · in development</p>
        {
          checklist.map((item) => (
            <p class={item.done ? 'is-done' : ''}>
              {item.done ? '✓' : '○'} {item.label}
            </p>
          ))
        }
      </div>
      <p class="agent-terminal__prompt">› Mark offline sync as done</p>
      <p class="agent-terminal__tool agent-terminal__tool--pending">
        <span class="agent-terminal__dot"></span>
        <span>LaunchBuddy <b>Update Task</b></span>
        <span class="agent-terminal__result">waiting for approval</span>
      </p>
    </div>
  </div>

  <div class="agent-terminal__approval">
    <img src="/appicon.png" alt="" width="36" height="36" loading="lazy" decoding="async" />
    <div class="agent-terminal__approval-copy">
      <p class="agent-terminal__approval-title">Agent wants to update a task</p>
      <p class="agent-terminal__approval-body">“Fix offline sync” → Done</p>
    </div>
    <div class="agent-terminal__approval-actions">
      <span>Deny</span>
      <span class="is-primary">Approve</span>
    </div>
  </div>
</div>
