---
interface Props {
  rating: number;
  size?: 'sm' | 'lg';
}

const { rating, size = 'sm' } = Astro.props;

const fullStars = Math.floor(rating);
const decimal = rating - fullStars;
const showPartialStar = decimal >= 0.25;
const partialFill = Math.min(Math.round(decimal * 100), 100);
const iconClass = size === 'lg' ? 'w-12 h-12' : 'w-5 h-5';
const starPath =
  'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';
const spacing = size === 'lg' ? 'ml-2 first:ml-0' : 'ml-1 first:ml-0';
---

<div class="flex items-center">
  {
    Array.from({ length: fullStars }).map(() => (
      <div class={`text-yellow-400 ${spacing}`}>
        <svg class={iconClass} fill="currentColor" viewBox="0 0 20 20">
          <path d={starPath} />
        </svg>
      </div>
    ))
  }
  {
    showPartialStar && (
      <div class={`text-yellow-400 relative ${size === 'lg' ? 'ml-2' : 'ml-1'}`}>
        <svg class={iconClass} fill="currentColor" viewBox="0 0 20 20">
          <path d={starPath} />
        </svg>
        <div
          class="absolute inset-0 bg-gray-950/90"
          style={`clip-path: polygon(${partialFill}% 0%, 100% 0%, 100% 100%, ${partialFill}% 100%)`}
        />
      </div>
    )
  }
</div>
