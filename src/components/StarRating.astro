---
interface Props {
  rating: number;
  size?: 'sm' | 'lg';
}

const { rating, size = 'sm' } = Astro.props;

const clamped = Math.min(Math.max(rating, 0), 5);
const fullStars = Math.floor(clamped);
const decimal = clamped - fullStars;
const partialPercent = Math.round(decimal * 100);
const showPartial = partialPercent > 0 && fullStars < 5;
const emptyStars = 5 - fullStars - (showPartial ? 1 : 0);

const iconClass = size === 'lg' ? 'w-10 h-10' : 'w-4 h-4';
const starPath =
  'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';
const spacing = size === 'lg' ? 'gap-1' : 'gap-0.5';
---

<div class={`inline-flex items-center ${spacing}`}>
  {
    Array.from({ length: fullStars }).map(() => (
      <svg class={`${iconClass} text-amber-400 shrink-0`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path d={starPath} />
      </svg>
    ))
  }
  {
    showPartial && (
      <div class={`relative shrink-0 ${iconClass}`}>
        <svg class={`${iconClass} text-white/20 block`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d={starPath} />
        </svg>
        <div class="absolute inset-0 overflow-hidden" style={`width: ${partialPercent}%`}>
          <svg class={`${iconClass} text-amber-400 block`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d={starPath} />
          </svg>
        </div>
      </div>
    )
  }
  {
    Array.from({ length: emptyStars }).map(() => (
      <svg class={`${iconClass} text-white/20 shrink-0`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path d={starPath} />
      </svg>
    ))
  }
</div>
