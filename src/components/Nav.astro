---
import { Image } from 'astro:assets';
import ShipCTA from './ShipCTA.astro';
import appIcon from '../assets/app-icon.png';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/blog/', label: 'Blog', section: '/blog' },
  { href: '/checklist/', label: 'Checklist', section: '/checklist' },
];
---

<header class="site-nav" data-site-nav>
  <nav class="site-nav__bar" aria-label="Main">
    <a class="site-nav__brand" href="/" aria-label="LaunchBuddy home">
      <Image src={appIcon} width={64} height={64} alt="" loading="eager" />
      <span class="hidden min-[360px]:inline">LaunchBuddy</span>
    </a>

    <div class="site-nav__links">
      {
        links.map((link) => (
          <a
            class="site-nav__link"
            href={link.href}
            aria-current={link.section && currentPath.startsWith(link.section) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="site-nav__actions">
      <a class="site-nav__icon" href="https://twitter.com/LaunchBuddy_App" aria-label="LaunchBuddy on X">
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
      </a>
      <ShipCTA size="sm" compact />
    </div>
  </nav>
</header>
