---
import { Image } from 'astro:assets';
import ShipCTA from './ShipCTA.astro';
import appIcon from '../assets/app-icon.png';
import framebuddyIcon from '../assets/frames/framebuddy-icon.png';
import { CHECKLIST_PATH, FRAMES_PATH } from '../lib/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/changelog/', label: 'Changelog', section: '/changelog' },
  { href: '/blog/', label: 'Blog', section: '/blog' },
];

const tools = [
  { href: CHECKLIST_PATH, label: 'Launch checklist', description: 'Free PDF for your first App Store submit' },
  { href: FRAMES_PATH, label: 'FrameBuddy', description: 'Free device frames for screenshots', icon: framebuddyIcon },
];

const isToolPage = tools.some((tool) => currentPath.startsWith(tool.href));
---

<header class="site-nav" data-site-nav>
  <nav class="site-nav__bar" aria-label="Main">
    <a class="site-nav__brand" href="/" aria-label="LaunchBuddy home">
      <Image src={appIcon} width={64} height={64} alt="" loading="eager" />
      <span class="hidden min-[360px]:inline">LaunchBuddy</span>
    </a>

    <div class="site-nav__links">
      {
        links.map((link) => (
          <a
            class="site-nav__link"
            href={link.href}
            aria-current={link.section && currentPath.startsWith(link.section) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <div class="site-nav__menu" data-nav-menu>
        <button
          type="button"
          class:list={['site-nav__link site-nav__menu-button', isToolPage && 'is-current']}
          aria-expanded="false"
          aria-controls="nav-tools"
        >
          Tools
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
        <div id="nav-tools" class="site-nav__dropdown">
          <ul class="site-nav__dropdown-panel">
            {
              tools.map((tool) => (
                <li>
                  <a
                    class="site-nav__tool"
                    href={tool.href}
                    aria-current={currentPath.startsWith(tool.href) ? 'page' : undefined}
                  >
                    {tool.icon ? (
                      <Image src={tool.icon} width={64} height={64} alt="" class="site-nav__tool-icon" />
                    ) : (
                      <span class="site-nav__tool-icon site-nav__tool-icon--checklist" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" />
                        </svg>
                      </span>
                    )}
                    <span>
                      <span class="site-nav__tool-label">{tool.label}</span>
                      <span class="site-nav__tool-description">{tool.description}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="site-nav__actions">
      <a class="site-nav__icon" href="https://twitter.com/LaunchBuddy_App" aria-label="LaunchBuddy on X">
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
      </a>
      <ShipCTA size="sm" compact />
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-nav-menu]').forEach((menu) => {
    const button = menu.querySelector('button');
    if (!button) return;

    let openedByHover = false;
    const setOpen = (open: boolean) => {
      menu.toggleAttribute('data-open', open);
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => {
      setOpen(openedByHover || !menu.hasAttribute('data-open'));
      openedByHover = false;
    });
    menu.addEventListener('mouseenter', () => {
      openedByHover = !menu.hasAttribute('data-open');
      setOpen(true);
    });
    menu.addEventListener('mouseleave', () => {
      openedByHover = false;
      setOpen(false);
    });
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.hasAttribute('data-open')) return;
      setOpen(false);
      button.focus();
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false);
    });
  });
</script>
