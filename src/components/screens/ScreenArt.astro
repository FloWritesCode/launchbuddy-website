---
import type { ScreenEntry } from '../../lib/screens';

interface Props {
  screen: ScreenEntry;
}

const { screen } = Astro.props;
const { art, image, imageAlt, app, title } = screen;
---

{
  art === 'photo' && image ? (
    <img src={image} alt={imageAlt ?? `${app} — ${title}`} class="h-full w-full object-cover object-top" />
  ) : art === 'flighty-home' ? (
    <div class="h-full bg-[#07111f] text-white flex flex-col">
      <div class="px-5 pt-14">
        <p class="text-[10px] font-mono uppercase tracking-[0.22em] text-sky-300/80">Today · SFO</p>
        <div class="mt-3 flex items-end justify-between">
          <div>
            <p class="text-[11px] text-white/50">UA 215 · on time</p>
            <p class="text-[2rem] leading-none font-semibold tracking-tight">JFK</p>
          </div>
          <p class="text-3xl font-light text-sky-300 tabular-nums">2h 14m</p>
        </div>
      </div>
      <div class="mx-4 mt-5 rounded-[1.4rem] bg-gradient-to-br from-sky-500/25 via-indigo-500/10 to-transparent border border-white/10 p-4">
        <div class="flex items-center justify-between text-[11px] text-white/60">
          <span>SFO 08:20</span>
          <span class="h-px flex-1 mx-3 bg-white/20"></span>
          <span class="text-sky-200">NRT 1</span>
          <span class="h-px flex-1 mx-3 bg-white/20"></span>
          <span>JFK 16:55</span>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-2xl bg-black/30 py-3">
            <p class="text-[10px] text-white/45">Gate</p>
            <p class="text-lg font-semibold">B12</p>
          </div>
          <div class="rounded-2xl bg-black/30 py-3">
            <p class="text-[10px] text-white/45">Seat</p>
            <p class="text-lg font-semibold">12A</p>
          </div>
          <div class="rounded-2xl bg-emerald-400/15 py-3">
            <p class="text-[10px] text-emerald-200/80">Status</p>
            <p class="text-lg font-semibold text-emerald-300">On time</p>
          </div>
        </div>
      </div>
      <div class="px-5 mt-5 space-y-3 flex-1">
        <div class="flex items-center justify-between text-sm">
          <span class="text-white/55">Bag drop</span>
          <span class="text-white/90">closes 07:35</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-white/55">Terminal</span>
          <span class="text-white/90">International 3</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-white/55">Aircraft</span>
          <span class="text-white/90">Boeing 777</span>
        </div>
      </div>
      <div class="mt-auto px-6 pb-8 flex justify-around text-[10px] uppercase tracking-wider text-white/35">
        <span class="text-sky-300">Flights</span>
        <span>Trips</span>
        <span>Alerts</span>
      </div>
    </div>
  ) : art === 'flighty-onboarding' ? (
    <div class="h-full bg-[#081018] text-white flex flex-col px-6 pt-16 pb-8">
      <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-sky-300/70">Step 2 of 3</p>
      <p class="mt-4 text-[1.7rem] leading-tight font-semibold">Import trips from your calendar</p>
      <p class="mt-3 text-sm text-white/55 leading-relaxed">Flighty finds flight numbers in events and turns them into live boards — no typing confirmation codes.</p>
      <div class="mt-8 rounded-3xl border border-white/10 bg-white/5 p-4">
        <div class="rounded-2xl bg-[#0f1c2e] p-4">
          <p class="text-[10px] text-white/40">Tue · Calendar</p>
          <p class="mt-1 font-medium">UA 215 SFO → JFK</p>
          <p class="text-xs text-sky-300 mt-1">Will become a live flight</p>
        </div>
        <div class="mt-3 rounded-2xl bg-[#0f1c2e]/70 p-4 opacity-60">
          <p class="text-[10px] text-white/40">Wed · Calendar</p>
          <p class="mt-1 font-medium">Dinner with Alex</p>
          <p class="text-xs text-white/35 mt-1">Ignored</p>
        </div>
      </div>
      <div class="mt-auto w-full rounded-2xl bg-sky-400 text-[#07111f] font-semibold py-3.5 text-sm text-center">Allow calendar access</div>
    </div>
  ) : art === 'copilot-home' ? (
    <div class="h-full bg-[#f6f1ea] text-[#1c1916] flex flex-col">
      <div class="px-5 pt-14">
        <p class="text-[11px] uppercase tracking-[0.18em] text-[#8a7d70]">September</p>
        <p class="text-[11px] text-[#8a7d70] mt-3">Net worth</p>
        <p class="text-[2.1rem] leading-none font-semibold tracking-tight">$184,220</p>
        <p class="text-xs text-emerald-700 mt-2">+$1,240 this month</p>
      </div>
      <svg class="mx-4 mt-4 h-16 w-[calc(100%-2rem)]" viewBox="0 0 280 64" fill="none" aria-hidden="true">
        <path d="M0 48 C40 48 50 20 90 28 C130 36 150 8 190 14 C230 20 250 32 280 18" stroke="#c45c26" stroke-width="2.5"></path>
      </svg>
      <div class="px-5 mt-2">
        <p class="text-[11px] uppercase tracking-[0.16em] text-[#8a7d70] mb-3">Spent</p>
        <div class="space-y-2.5">
          {[{ n: 'Groceries', a: '$420', w: '70%' }, { n: 'Dining', a: '$188', w: '40%' }, { n: 'Travel', a: '$96', w: '22%' }].map((row) => (
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span>{row.n}</span>
                <span class="tabular-nums text-[#6b5e52]">{row.a}</span>
              </div>
              <div class="h-1.5 rounded-full bg-[#e4d8cc]">
                <div class="h-full rounded-full bg-[#c45c26]" style={`width:${row.w}`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-auto px-6 pb-8 flex justify-around text-[10px] uppercase tracking-wider text-[#b0a398]">
        <span class="text-[#c45c26]">Home</span>
        <span>Cash</span>
        <span>Recurring</span>
      </div>
    </div>
  ) : art === 'copilot-paywall' ? (
    <div class="h-full bg-[#f6f1ea] text-[#1c1916] flex flex-col px-6 pt-16 pb-8">
      <p class="text-[10px] uppercase tracking-[0.2em] text-[#8a7d70]">Copilot Pro</p>
      <p class="mt-3 text-[1.75rem] leading-tight font-semibold">See where the money actually goes</p>
      <p class="mt-3 text-sm text-[#6b5e52] leading-relaxed">Unlimited accounts, Apple Watch, and a real budget — not a spreadsheet you abandon.</p>
      <div class="mt-8 rounded-3xl bg-white border border-[#e4d8cc] p-4 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-[10px] uppercase tracking-widest text-[#c45c26]">Best value</p>
            <p class="font-semibold mt-1">Yearly</p>
          </div>
          <p class="text-xl font-semibold">$79<span class="text-sm font-normal text-[#8a7d70]">/yr</span></p>
        </div>
        <p class="text-xs text-[#8a7d70] mt-2">Save 40% versus monthly</p>
      </div>
      <div class="mt-3 rounded-3xl border border-[#e4d8cc] p-4 text-[#8a7d70]">
        <div class="flex items-center justify-between">
          <p class="font-medium text-[#1c1916]">Monthly</p>
          <p>$13/mo</p>
        </div>
      </div>
      <p class="mt-6 text-xs text-center text-[#8a7d70]">Loved by 1M+ people who got tired of Mint.</p>
      <div class="mt-auto w-full rounded-2xl bg-[#1c1916] text-[#f6f1ea] font-semibold py-3.5 text-sm text-center">Continue</div>
    </div>
  ) : art === 'things-today' ? (
    <div class="h-full bg-[#f7f4ef] text-[#2b261f] flex flex-col">
      <div class="px-5 pt-14 flex items-end justify-between">
        <p class="text-[2rem] font-semibold tracking-tight">Today</p>
        <span class="text-sm text-[#b08a4a]">4</span>
      </div>
      <div class="px-5 mt-6 space-y-5 flex-1">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#c45c3a] mb-2">Morning</p>
          <div class="space-y-2">
            <div class="flex items-start gap-3">
              <span class="mt-1 h-4 w-4 rounded-full border-[1.5px] border-[#c9bfb2]"></span>
              <span class="text-[15px]">Review App Store notes</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1 h-4 w-4 rounded-full border-[1.5px] border-[#c9bfb2]"></span>
              <span class="text-[15px]">Ship 1.8 checklist</span>
            </div>
          </div>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#3b6ea5] mb-2">Anytime</p>
          <div class="flex items-start gap-3">
            <span class="mt-1 h-4 w-4 rounded-full border-[1.5px] border-[#c9bfb2]"></span>
            <span class="text-[15px]">Reply to the 2-star review</span>
          </div>
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#6a8f4e] mb-2">Evening</p>
          <div class="flex items-start gap-3">
            <span class="mt-1 h-4 w-4 rounded-full border-[1.5px] border-[#c9bfb2]"></span>
            <span class="text-[15px]">Read TestFlight notes</span>
          </div>
        </div>
      </div>
      <div class="mt-auto px-6 pb-8 flex justify-around text-[10px] uppercase tracking-wider text-[#b5aa9c]">
        <span class="text-[#c45c3a]">Inbox</span>
        <span>Today</span>
        <span>Upcoming</span>
      </div>
    </div>
  ) : art === 'structured-day' ? (
    <div class="h-full bg-[#f3f6fb] text-[#1b2430] flex flex-col">
      <div class="px-5 pt-14 flex items-center justify-between">
        <p class="text-2xl font-semibold">Tuesday</p>
        <span class="text-xs text-[#7d8b9a]">21 Sep</span>
      </div>
      <div class="px-4 mt-4 flex-1 relative">
        <div class="absolute left-12 top-0 bottom-8 w-px bg-[#d5deea]"></div>
        <div class="space-y-3">
          <div class="flex gap-3 items-start">
            <span class="w-8 text-[10px] text-[#7d8b9a] pt-2">08</span>
            <div class="flex-1 rounded-2xl bg-[#dce8fb] px-3 py-2">
              <p class="text-sm font-medium">Deep work</p>
              <p class="text-[10px] text-[#5b6f8a]">3h · Studio</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <span class="w-8 text-[10px] text-[#7d8b9a] pt-2">11</span>
            <div class="flex-1 rounded-2xl bg-white border border-[#e4ebf3] px-3 py-2">
              <p class="text-sm font-medium">Standup</p>
              <p class="text-[10px] text-[#7d8b9a]">30m</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <span class="w-8 text-[10px] text-sky-600 pt-2 font-semibold">13</span>
            <div class="flex-1 rounded-2xl bg-sky-500 text-white px-3 py-2 shadow-md shadow-sky-500/20">
              <p class="text-sm font-medium">Now · Lunch</p>
              <p class="text-[10px] text-white/80">1h</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <span class="w-8 text-[10px] text-[#7d8b9a] pt-2">16</span>
            <div class="flex-1 rounded-2xl bg-[#fbe7d4] px-3 py-2">
              <p class="text-sm font-medium">App Review notes</p>
              <p class="text-[10px] text-[#9a6a3a]">2h</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  ) : art === 'ivory-timeline' ? (
    <div class="h-full bg-[#111214] text-[#f2f2f3] flex flex-col">
      <div class="px-5 pt-14 pb-3 border-b border-white/5">
        <p class="text-lg font-semibold">Home</p>
      </div>
      <div class="flex-1 divide-y divide-white/5">
        {
          [
            { n: 'Iconfactory', h: '@iconfactory', t: 'Shipping a tiny Mac utility is still the most fun job in software.' },
            { n: 'Tapbots', h: '@tapbots', t: 'Ivory 2.2 is out. Lists, filters, and a quieter boost style.' },
          ].map((post) => (
            <div class="px-5 py-3.5 flex gap-3">
              <div class="h-8 w-8 rounded-full bg-gradient-to-br from-violet-400 to-sky-500 shrink-0"></div>
              <div>
                <p class="text-[13px] font-medium">
                  {post.n} <span class="text-white/35 font-normal">{post.h}</span>
                </p>
                <p class="text-[13px] text-white/80 mt-1 leading-snug">{post.t}</p>
              </div>
            </div>
          ))
        }
        <div class="px-5 py-3.5 flex gap-3 opacity-70">
          <div class="h-8 w-8 rounded-full bg-white/10 shrink-0"></div>
          <div>
            <p class="text-[11px] text-white/35 mb-1">boosted by Maya</p>
            <p class="text-[13px] text-white/80 leading-snug">If your empty state needs a paragraph, the first-run is wrong.</p>
          </div>
        </div>
      </div>
      <div class="mt-auto px-6 pb-8 flex justify-around text-[10px] uppercase tracking-wider text-white/30">
        <span class="text-violet-300">Home</span>
        <span>Mentions</span>
        <span>Profile</span>
      </div>
    </div>
  ) : art === 'ivory-settings' ? (
    <div class="h-full bg-[#111214] text-[#f2f2f3] flex flex-col px-5 pt-14">
      <p class="text-xl font-semibold mb-5">Composer</p>
      <div class="rounded-2xl bg-white/5 overflow-hidden divide-y divide-white/5 text-sm">
        {
          [
            ['Default visibility', 'Public'],
            ['Language', 'English'],
            ['Warn before posting', 'On'],
            ['Append app name', 'Off'],
          ].map(([k, v]) => (
            <div class="flex items-center justify-between px-4 py-3.5">
              <span>{k}</span>
              <span class="text-white/40">{v}</span>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-[11px] uppercase tracking-[0.16em] text-white/35 mb-2">When posting</p>
      <div class="rounded-2xl bg-white/5 overflow-hidden divide-y divide-white/5 text-sm">
        <div class="flex items-center justify-between px-4 py-3.5">
          <span>Mark sensitive</span>
          <span class="h-5 w-9 rounded-full bg-violet-500 relative"><span class="absolute right-0.5 top-0.5 h-4 w-4 rounded-full bg-white"></span></span>
        </div>
        <div class="flex items-center justify-between px-4 py-3.5">
          <span>Auto-alt text</span>
          <span class="h-5 w-9 rounded-full bg-white/10 relative"><span class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white/70"></span></span>
        </div>
      </div>
    </div>
  ) : art === 'carrot-home' ? (
    <div class="h-full bg-[#140b08] text-[#f7e7c6] flex flex-col">
      <div class="px-5 pt-16">
        <p class="text-[11px] uppercase tracking-[0.2em] text-[#e8a45a]">Berlin</p>
        <p class="mt-6 text-[5.5rem] leading-none font-semibold tracking-tighter">9°</p>
        <p class="mt-2 text-lg text-[#e8a45a]">Obviously raining. Coat. Dignity optional.</p>
      </div>
      <div class="mt-auto px-4 pb-10">
        <div class="flex gap-2 overflow-hidden">
          {['Now', '14', '15', '16', '17', '18'].map((h, i) => (
            <div class="min-w-[3.1rem] rounded-2xl bg-[#2a160f] py-3 text-center">
              <p class="text-[10px] text-[#e8a45a]/70">{h}</p>
              <p class="text-sm mt-1">{[9, 9, 8, 8, 7, 6][i]}°</p>
              <p class="text-[10px] mt-1 text-[#7ec8e3]">{['88%', '70%', '40%', '20%', '10%', '5%'][i]}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : art === 'halide-camera' ? (
    <div class="h-full bg-black text-white flex flex-col">
      <div class="px-4 pt-12 flex items-center justify-between text-[10px] font-mono text-white/60">
        <span>RAW</span>
        <span class="text-yellow-300">1/125 · f1.8 · ISO 64</span>
        <span>HEIF</span>
      </div>
      <div class="mx-3 mt-2 flex-1 rounded-[1.2rem] bg-gradient-to-b from-zinc-700 via-zinc-600 to-zinc-800 relative overflow-hidden">
        <div class="absolute inset-x-6 top-1/2 h-px bg-white/30"></div>
        <div class="absolute inset-y-8 left-1/2 w-px bg-white/30"></div>
        <div class="absolute right-3 top-3 bottom-3 w-1.5 rounded-full bg-black/40 overflow-hidden">
          <div class="absolute bottom-0 inset-x-0 h-2/3 bg-gradient-to-t from-emerald-400 to-yellow-300"></div>
        </div>
      </div>
      <div class="px-5 py-5 flex items-center justify-between">
        <div class="h-9 w-9 rounded-full border border-white/30"></div>
        <div class="h-16 w-16 rounded-full border-[3px] border-white p-1">
          <div class="h-full w-full rounded-full bg-white"></div>
        </div>
        <p class="text-xs font-mono w-9 text-right">1×</p>
      </div>
    </div>
  ) : art === 'drafts-capture' ? (
    <div class="h-full bg-[#fbfaf6] text-[#222] flex flex-col">
      <div class="px-5 pt-14 flex items-center justify-between text-[11px] text-[#8a8578]">
        <span>Inbox</span>
        <span>Aa</span>
      </div>
      <div class="px-5 mt-6 flex-1">
        <p class="text-[#c9c4b6] text-lg leading-relaxed">Start typing…</p>
      </div>
      <div class="px-3 pb-6">
        <div class="rounded-t-xl bg-[#e8e4d9] p-2 grid grid-cols-10 gap-1 text-center text-[11px] text-[#3d3a32]">
          {'QWERTYUIOP'.split('').map((k) => (
            <span class="bg-white rounded py-2 shadow-sm">{k}</span>
          ))}
        </div>
        <div class="bg-[#e8e4d9] px-2 pb-2 grid grid-cols-9 gap-1 text-center text-[11px] text-[#3d3a32]">
          {'ASDFGHJKL'.split('').map((k) => (
            <span class="bg-white rounded py-2 shadow-sm">{k}</span>
          ))}
        </div>
        <div class="bg-[#e8e4d9] rounded-b-xl px-2 pb-2 pt-1 flex justify-center gap-1 text-[11px]">
          {'ZXCVBNM'.split('').map((k) => (
            <span class="bg-white rounded py-2 px-2 shadow-sm">{k}</span>
          ))}
        </div>
      </div>
    </div>
  ) : art === 'sofa-queue' ? (
    <div class="h-full bg-[#16141c] text-white flex flex-col">
      <div class="px-5 pt-14">
        <p class="text-2xl font-semibold">Queue</p>
        <p class="text-xs text-white/40 mt-1">12 saved · 3 episodes left</p>
      </div>
      <div class="px-4 mt-5 space-y-3">
        {
          [
            { t: 'The Bear', m: 'S3 E2 · 31m', c: 'from-orange-500 to-red-700' },
            { t: 'Dune: Part Two', m: 'Film · 2h 46m', c: 'from-amber-200 to-stone-700' },
            { t: 'Severance', m: 'S2 E4 · 48m', c: 'from-emerald-200 to-green-900' },
          ].map((item) => (
            <div class="flex gap-3 items-center">
              <div class={`h-16 w-12 rounded-lg bg-gradient-to-br ${item.c} shrink-0`}></div>
              <div class="min-w-0">
                <p class="font-medium truncate">{item.t}</p>
                <p class="text-xs text-white/40 mt-0.5">{item.m}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  ) : art === 'sofa-empty' ? (
    <div class="h-full bg-[#16141c] text-white flex flex-col items-center justify-center px-8 text-center">
      <div class="h-20 w-16 rounded-xl border-2 border-dashed border-white/20 mb-6"></div>
      <p class="text-xl font-semibold">Nothing in the queue</p>
      <p class="text-sm text-white/50 mt-2 leading-relaxed">Save a show, a film, or a game. Sofa is the list you actually finish.</p>
      <div class="mt-8 rounded-full bg-violet-400 text-[#16141c] font-semibold px-5 py-2.5 text-sm">Add the first thing</div>
    </div>
  ) : art === 'parcel-list' ? (
    <div class="h-full bg-[#f4f5f7] text-[#1a1d23] flex flex-col">
      <div class="px-5 pt-14">
        <p class="text-2xl font-semibold">Parcels</p>
      </div>
      <div class="px-4 mt-4 space-y-3">
        <div class="rounded-2xl bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-[11px] uppercase tracking-widest text-emerald-600">Out for delivery</p>
            <p class="text-xs text-[#8b909a]">DHL</p>
          </div>
          <p class="font-medium mt-1">Keyboard case</p>
          <div class="mt-3 h-1 rounded-full bg-[#eceef1]">
            <div class="h-full w-5/6 rounded-full bg-emerald-500"></div>
          </div>
        </div>
        <div class="rounded-2xl bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-[11px] uppercase tracking-widest text-sky-600">In transit</p>
            <p class="text-xs text-[#8b909a]">USPS</p>
          </div>
          <p class="font-medium mt-1">LaunchBuddy stickers</p>
          <div class="mt-3 h-1 rounded-full bg-[#eceef1]">
            <div class="h-full w-2/5 rounded-full bg-sky-500"></div>
          </div>
        </div>
        <div class="rounded-2xl bg-white p-4 shadow-sm opacity-70">
          <p class="text-[11px] uppercase tracking-widest text-[#8b909a]">Delivered</p>
          <p class="font-medium mt-1">iPhone case</p>
        </div>
      </div>
    </div>
  ) : art === 'timery-home' ? (
    <div class="h-full bg-[#0e0f12] text-white flex flex-col">
      <div class="px-5 pt-16 text-center">
        <p class="text-[11px] uppercase tracking-[0.2em] text-white/35">Today</p>
