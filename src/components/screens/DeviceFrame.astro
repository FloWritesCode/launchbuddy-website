---
import type { Chrome, ScreenDevice } from '../../lib/screens';

interface Props {
  device: ScreenDevice;
  chrome?: Chrome;
  interactive?: boolean;
  size?: 'card' | 'detail';
}

const { device, chrome = 'dark', interactive = false, size = 'card' } = Astro.props;
const isDark = chrome === 'dark';
---

<div
  class:list={[
    'device',
    `device--${device}`,
    `device--${size}`,
    isDark ? 'device--dark' : 'device--light',
    interactive && 'device--interactive',
  ]}
>
  <div class="device__chrome">
    {
      device === 'mac' && (
        <div class="device__titlebar">
          <span class="device__traffic device__traffic--close"></span>
          <span class="device__traffic device__traffic--min"></span>
          <span class="device__traffic device__traffic--zoom"></span>
        </div>
      )
    }
    {
      device === 'iphone' && (
        <>
          <div class="device__island" aria-hidden="true"></div>
          <div class="device__statusbar" aria-hidden="true">
            <span class="device__time">9:41</span>
            <span class="device__status-icons">
              <svg viewBox="0 0 18 12" class="device__signal"><path d="M1 10h2v2H1v-2zm4-3h2v5H5V7zm4-3h2v8H9V4zm4-3h2v11h-2V1z" fill="currentColor"/></svg>
              <svg viewBox="0 0 16 12" class="device__wifi"><path d="M8 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-3.5-3C5.8 6.2 6.9 5.7 8 5.7s2.2.5 3.5 1.8l-1.1 1.1C9.7 7.9 8.9 7.6 8 7.6s-1.7.3-2.4.8L4.5 7.5zm-2.2-2.2C4.1 3.5 6 2.7 8 2.7s3.9.8 5.7 2.6L12.6 6.4C11.2 5 9.7 4.4 8 4.4s-3.2.6-4.6 2L2.3 5.3z" fill="currentColor"/></svg>
              <span class="device__battery"><span></span></span>
            </span>
          </div>
        </>
      )
    }
    {
      device === 'ipad' && (
        <div class="device__statusbar device__statusbar--ipad" aria-hidden="true">
          <span class="device__time">9:41</span>
          <span class="device__status-icons">
            <span class="device__battery"><span></span></span>
          </span>
        </div>
      )
    }
    {
      device === 'watch' && (
        <div class="device__watch-time" aria-hidden="true">9:41</div>
      )
    }
    <div class="device__screen">
      <slot />
    </div>
    {(device === 'iphone' || device === 'ipad') && <div class="device__home" aria-hidden="true"></div>}
  </div>
</div>
