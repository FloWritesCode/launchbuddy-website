---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { APP_STORE_URL, CHECKLIST_PATH, PRIVACY_POLICY_URL, SUPPORT_URL, TERMS_URL } from '../lib/site';

const columns = [
  {
    heading: 'Product',
    links: [
      { href: '/#features', label: 'Features' },
      { href: '/#pricing', label: 'Pricing' },
      { href: '/#faq', label: 'FAQ' },
      { href: APP_STORE_URL, label: 'Download' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { href: '/blog/', label: 'Blog' },
      { href: CHECKLIST_PATH, label: 'Launch checklist' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: SUPPORT_URL, label: 'Support' },
      { href: 'https://twitter.com/LaunchBuddy_App', label: 'X / Twitter' },
      { href: PRIVACY_POLICY_URL, label: 'Privacy' },
      { href: TERMS_URL, label: 'Terms' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div>
      <a class="site-footer__brand" href="/">
        <Image src={appIcon} width={72} height={72} alt="" />
        LaunchBuddy
      </a>
      <p class="site-footer__tagline">
        The release command center for indie developers. Plan it, check it, ship it — on iPhone,
        iPad, and Mac.
      </p>
    </div>

    <nav class="site-footer__cols" aria-label="Footer">
      {
        columns.map((column) => (
          <div>
            <p class="mono-kicker site-footer__heading">{column.heading}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <p class="site-footer__wordmark" aria-hidden="true">LaunchBuddy</p>

  <div class="site-footer__bottom">
    <p>&copy; Florian Schweizer 2022–2026</p>
    <p>Made for indie devs who ship.</p>
  </div>
</footer>
