  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <p>
      <a class="text-gray-500 no-underline hover:text-gray-300" href="/">&copy; Florian Schweizer 2022-2026</a>
    </p>
    <nav class="flex flex-wrap justify-center md:justify-end gap-x-6 gap-y-2">
      <a class="text-gray-500 no-underline hover:text-gray-300" href={PRIVACY_POLICY_URL}>Privacy</a>
      <a class="text-gray-500 no-underline hover:text-gray-300" href={TERMS_URL}>Terms</a>
