---
import { FEATURE_COMPARISON, PRO_MONTHLY_PRICE } from '../lib/site';
---

<div class="feature-table-wrap glass-card glass-card--static">
  <div class="feature-table-scroll">
    <table class="feature-table">
      <thead>
        <tr>
          <th scope="col" class="feature-table__feature-col">Features</th>
          <th scope="col" class="feature-table__tier-col">Free</th>
          <th scope="col" class="feature-table__tier-col feature-table__tier-col--pro">
            Pro
            <span class="feature-table__tier-price">{PRO_MONTHLY_PRICE}/mo</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          FEATURE_COMPARISON.map((category) => (
            <>
              <tr class="feature-table__category">
                <th scope="rowgroup" colspan="3">
                  {category.title}
                </th>
              </tr>
              {category.features.map((feature) => (
                <tr>
                  <th scope="row" class="feature-table__feature-name">
                    <span class="feature-table__feature-label">
                      {feature.name}
                      {
                        feature.hint && (
                          <span class="feature-table__info" title={feature.hint} tabindex="0">
                            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.25" />
                              <path
                                d="M8 7.25v3.5M8 5.5h.01"
                                stroke="currentColor"
                                stroke-width="1.25"
                                stroke-linecap="round"
                              />
                            </svg>
                            <span class="sr-only">{feature.hint}</span>
                          </span>
                        )
                      }
                    </span>
                  </th>
                  <td class="feature-table__cell">
                    {
                      feature.free === true ? (
                        <span class="feature-table__check" aria-label="Included">
                          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" />
                            <path
                              d="M5 8l2 2 4-4"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                      ) : feature.free === false ? (
                        <span class="feature-table__dash" aria-label="Not included">—</span>
                      ) : (
                        <span class="feature-table__label">{feature.free}</span>
                      )
                    }
                  </td>
                  <td class="feature-table__cell feature-table__cell--pro">
                    {
                      feature.pro === true ? (
                        <span class="feature-table__check" aria-label="Included">
                          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" />
                            <path
                              d="M5 8l2 2 4-4"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                      ) : feature.pro === false ? (
                        <span class="feature-table__dash" aria-label="Not included">—</span>
                      ) : (
                        <span class="feature-table__label">{feature.pro}</span>
                      )
                    }
                  </td>
                </tr>
              ))}
            </>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
