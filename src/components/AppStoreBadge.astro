---
import { APP_STORE_URL } from '../lib/site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const heights = {
  sm: 'h-10',
  md: 'h-14',
  lg: 'h-[4.5rem]',
};
---

<a
  href={APP_STORE_URL}
  class={`inline-flex shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_20px_rgba(56,189,248,0.3)] ${className}`}
>
  <img
    src="/App Store.svg"
    class={`${heights[size]} w-auto block`}
    alt="Download LaunchBuddy on the App Store"
  />
</a>
