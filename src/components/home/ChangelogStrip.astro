---
import { Image } from 'astro:assets';
import { changelog, changelogPath, formatChangelogDate } from '../../lib/changelog';

const latest = changelog[0];
---

<section id="changelog" class="section-block max-w-6xl mx-auto px-6" aria-labelledby="changelog-title">
  <div class="guides__head">
    <div>
      <p class="section-label" data-reveal>Changelog</p>
      <h2 id="changelog-title" class="section-heading" data-reveal>What just shipped.</h2>
    </div>
    <a class="guides__all" href="/changelog/" data-reveal>All releases →</a>
  </div>

  <a class="changelog-teaser glass-card glass-card--interactive spotlight" href={changelogPath(latest)} data-reveal>
    <Image
      src={latest.sections[0].shots[0].image}
      alt=""
      widths={[720, 1100]}
      sizes="(min-width: 900px) 46vw, 100vw"
      class="changelog-teaser__shot"
    />
    <div>
      <p class="font-mono text-sm text-text-muted mb-2">
        <time datetime={latest.date}>{formatChangelogDate(latest.date)}</time>
        <span aria-hidden="true"> · </span>
        {latest.version}
      </p>
      <h3 class="font-display font-bold text-2xl md:text-3xl text-text-primary mb-3">{latest.title}</h3>
      <p class="text-text-secondary">{latest.summary}</p>
    </div>
  </a>
</section>
