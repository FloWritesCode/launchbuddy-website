---
interface Props {
  active?: string;
  title?: string;
  sidebar?: boolean;
  class?: string;
}

const { active = 'plan', title = 'LaunchBuddy', sidebar = true, class: className = '' } = Astro.props;

const nav = [
  { label: 'Overview', for: '', icon: 'M7 3h7l4 4v14H7zM14 3v4h4' },
  { label: 'LaunchBuddy AI', for: 'ai', icon: 'M4 5h16v11H9l-5 4z' },
  { label: 'Releases', for: 'plan agents', icon: 'M3 7.5 12 3l9 4.5-9 4.5zM3 7.5v9L12 21l9-4.5v-9M12 12v9' },
  { label: 'Backlog', for: '', icon: 'M4 6h16M4 12h16M4 18h10' },
  { label: 'Reviews', for: 'app-store-connect', icon: 'M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z' },
  { label: 'Analytics', for: '', icon: 'M4 19l5-6 4 3 7-9' },
  { label: 'Checklists', for: 'checklists', icon: 'M4 6.5l1.8 1.8L9 5M12 7h8M4 13.5l1.8 1.8L9 12M12 14h8M12 20h8' },
  { label: 'App Ideas', for: '', icon: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.4.3.6.8.6 1.2v1h6v-1c0-.4.2-.9.6-1.2A6 6 0 0 0 12 3z' },
];
---

<div class:list={['app-window', { 'app-window--single': !sidebar }, className]} data-active={active}>
  <div class="app-window__bar">
    <span class="app-window__lights"><i></i><i></i><i></i></span>
    <span class="app-window__title">{title}</span>
  </div>
  <div class="app-window__main">
    {
      sidebar && (
        <div class="app-sidebar">
          <div class="app-sidebar__app">
            <span class="app-sidebar__icon" />
            <span>
              <span class="app-sidebar__name">Orbit Notes</span>
              <span class="app-sidebar__meta">Release 2.4 · iOS, macOS</span>
            </span>
          </div>
          <ul class="app-sidebar__nav">
            <li class="app-sidebar__highlight" />
            {nav.map((item) => (
              <li data-for={item.for || undefined}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={item.icon} />
                </svg>
                {item.label}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="app-window__content">
      <slot />
    </div>
  </div>
</div>
