---
const stats = [
  { label: 'Downloads · 7d', value: '1,284', delta: '+12%' },
  { label: 'Proceeds · 7d', value: '$412', delta: '+8%' },
  { label: 'Rating', value: '4.7★', delta: '142 ratings', neutral: true },
];
---

<div
  class="scene scene--asc"
  data-scene="app-store-connect"
  data-timeline="900 1200 1200 1100 1300"
  data-hold="2800"
>
  <div class="asc-stats">
    {
      stats.map((stat, index) => (
        <div class="asc-stat">
          <span class="asc-stat__label">{stat.label}</span>
          <strong>{stat.value}</strong>
          <em class:list={{ 'is-neutral': stat.neutral }}>{stat.delta}</em>
          {index === 0 && (
            <svg class="asc-spark" viewBox="0 0 120 32" fill="none" preserveAspectRatio="none">
              <path pathLength="1" d="M2 26 L18 22 L32 24 L48 15 L62 18 L78 10 L94 12 L118 4" />
            </svg>
          )}
        </div>
      ))
    }
  </div>

  <div class="asc-review">
    <div class="asc-review__top">
      <span class="asc-review__stars">★★<i>★★★</i></span>
      <span class="asc-review__meta">jules_k · 2d ago</span>
      <span class="asc-review__replied">Replied</span>
    </div>
    <p class="asc-review__title">Sync stopped working</p>
    <p class="asc-review__body">Notes don’t sync between my iPhone and Mac since the last update.</p>
    <div class="asc-reply">
      <span class="asc-reply__line asc-reply__line--1">Thanks for flagging this! 2.4 fixes sync,</span>
      <span class="asc-reply__line asc-reply__line--2">so update and you’re good to go.</span>
      <span class="asc-reply__send">
        <span>Send reply</span>
        <span>Sent ✓</span>
      </span>
    </div>
  </div>

  <div class="asc-notes">
    <div class="min-w-0">
      <p class="asc-notes__title">What’s New in 2.4</p>
      <p class="asc-notes__body">Shared notebooks, dark mode, and faster sync.</p>
    </div>
    <span class="asc-notes__push">
      <span>Push to ASC</span>
      <span>Pushing…</span>
      <span>Pushed ✓</span>
    </span>
  </div>
</div>
