---
import { getCollection } from 'astro:content';
import GuideCard from '../GuideCard.astro';
import { featuredPosts } from '../../lib/seo';

const guides = featuredPosts(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 6);
---

<section id="guides" class="section-block max-w-6xl mx-auto px-6" aria-labelledby="guides-title">
  <div class="guides__head">
    <div>
      <p class="section-label" data-reveal>Learn how to ship</p>
      <h2 id="guides-title" class="section-heading" data-reveal>
        App Store release guides for indie iOS developers.
      </h2>
    </div>
    <a class="guides__all" href="/blog/" data-reveal>All guides →</a>
  </div>

  <div class="guides__grid" data-reveal-stagger="90">
    {
      guides.map((post, index) => (
        <div data-reveal>
          <GuideCard post={post} index={index} />
        </div>
      ))
    }
  </div>
</section>
