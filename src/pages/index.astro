---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import CTAStack from '../components/CTAStack.astro';
import FeatureComparisonTable from '../components/FeatureComparisonTable.astro';
import ProBadge from '../components/ProBadge.astro';
import StarRating from '../components/StarRating.astro';
import VslPlayer from '../components/VslPlayer.astro';
import AgentTerminalPreview from '../components/AgentTerminalPreview.astro';
import heroDashboard from '../assets/hero-dashboard.png';
import crossPlatformSync from '../assets/cross-platform-sync.png';
import checklists from '../assets/checklists.png';
import reviews from '../assets/reviews.png';
import aiChat from '../assets/ai-chat.png';
import experiments from '../assets/experiments.png';
import vslPosterAsset from '../assets/vsl-poster.jpg';
import {
  APP_STORE_REVIEWS_URL,
  APP_STORE_RATING,
  APP_STORE_REVIEW_COUNT,
  APP_STORE_URL,
  DEFAULT_DESCRIPTION,
  FAQ_ITEMS,
  FREE_TIER_APPS,
  FREE_TIER_RELEASES,
  HOMEPAGE_BLOG_POSTS,
  PRO_MONTHLY_PRICE,
  PRO_YEARLY_PRICE,
  USER_COUNT,
  VSL_DESCRIPTION,
  VSL_DURATION_ISO,
  VSL_TITLE,
  VSL_UPLOAD_DATE,
  VSL_YOUTUBE_ID,
} from '../lib/site';

const vslPoster = await getImage({ src: vslPosterAsset, width: 1280, format: 'webp' });

const scatteredTools = [
  {
    tone: 'orange',
    text: 'Reviews live in App Store Connect.',
    icon: 'M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 5.11a.56.56 0 0 0 .47.35l5.52.44c.5.04.7.66.32.99l-4.2 3.6a.56.56 0 0 0-.18.56l1.28 5.39a.56.56 0 0 1-.84.61l-4.73-2.89a.56.56 0 0 0-.58 0l-4.73 2.89a.56.56 0 0 1-.84-.61l1.28-5.39a.56.56 0 0 0-.18-.56l-4.2-3.6a.56.56 0 0 1 .32-.99l5.52-.44a.56.56 0 0 0 .47-.35l2.13-5.11z',
  },
  {
    tone: 'green',
    text: 'Feedback is buried in your DMs.',
    icon: 'M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.42-4.03 8-9 8a9.86 9.86 0 0 1-4.26-.95L3 20l1.4-3.72A7.6 7.6 0 0 1 3 12c0-4.42 4.03-8 9-8s9 3.58 9 8z',
  },
  {
    tone: 'violet',
    text: 'Tasks sit in yet another kanban app.',
    icon: 'M4 5h4v14H4zM10 5h4v9h-4zM16 5h4v11h-4z',
  },
  {
    tone: 'slate',
    text: 'Release notes? Some random doc.',
    icon: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5zM14 3v5h5M9 13h6M9 17h4',
  },
  {
    tone: 'yellow',
    text: 'The release checklist? In your head.',
    icon: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.4.3.6.8.6 1.2v1h6v-1c0-.4.2-.9.6-1.2A6 6 0 0 0 12 3z',
  },
];

const slipAlerts = [
  {
    tone: 'red',
    title: 'Submission rejected',
    body: 'Missing 13-inch iPad screenshots',
    icon: 'M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z',
  },
  {
    tone: 'amber',
    title: 'New 1-star review',
    body: '“Dev never replies.” · 23 days unanswered',
    icon: 'M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 5.11a.56.56 0 0 0 .47.35l5.52.44c.5.04.7.66.32.99l-4.2 3.6a.56.56 0 0 0-.18.56l1.28 5.39a.56.56 0 0 1-.84.61l-4.73-2.89a.56.56 0 0 0-.58 0l-4.73 2.89a.56.56 0 0 1-.84-.61l1.28-5.39a.56.56 0 0 0-.18-.56l-4.2-3.6a.56.56 0 0 1 .32-.99l5.52-.44a.56.56 0 0 0 .47-.35l2.13-5.11z',
  },
  {
    tone: 'red',
    title: 'Release date missed',
    body: 'v2.4 was due last Friday',
    icon: 'M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  },
];

const homepageJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LaunchBuddy',
    description: DEFAULT_DESCRIPTION,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'iOS, macOS',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: APP_STORE_RATING,
      bestRating: '5',
      ratingCount: String(APP_STORE_REVIEW_COUNT),
    },
    url: 'https://launchbuddy.app',
    downloadUrl: APP_STORE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: VSL_TITLE,
    description: VSL_DESCRIPTION,
    thumbnailUrl: `https://i.ytimg.com/vi/${VSL_YOUTUBE_ID}/maxresdefault.jpg`,
    uploadDate: VSL_UPLOAD_DATE,
    duration: VSL_DURATION_ISO,
    embedUrl: `https://www.youtube.com/embed/${VSL_YOUTUBE_ID}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_ITEMS.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout path="/" preloadImage={vslPoster.src} jsonLd={homepageJsonLd}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
  </Fragment>

  <!-- Hero + VSL -->
  <section class="max-w-6xl mx-auto px-6 pt-8 md:pt-12 pb-16 md:pb-24">
    <div class="max-w-3xl mx-auto text-center">
      <div class="section-label fade-in">The release command center for indie devs</div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-[3.5rem] text-text-primary leading-[1.06] tracking-tight mb-5 fade-in fade-in-delay-1">
        Ship your next
        <span class="text-gradient"> App Store </span>
        release without the chaos
      </h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl mx-auto fade-in fade-in-delay-2">
        Plan releases, run submission checklists, reply to reviews, and ask AI that knows your apps —
        on iPhone, iPad, and Mac.
      </p>
    </div>

    <div class="max-w-4xl mx-auto mt-10 md:mt-12 fade-in-up fade-in-delay-2">
      <VslPlayer poster={vslPoster.src} />
    </div>

    <div class="mt-10 md:mt-12 flex flex-col items-center gap-8 fade-in fade-in-delay-3">
      <CTAStack size="lg" showBadge={false} showPricing showProTeaser />
      <div class="trust-strip justify-center">
        <span class="trust-strip__highlight">{USER_COUNT} developers</span>
        <span class="trust-strip__dot" aria-hidden="true"></span>
        <span>{APP_STORE_RATING} App Store rating</span>
        <span class="trust-strip__dot" aria-hidden="true"></span>
        <span>Free for {FREE_TIER_APPS} apps</span>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="max-w-6xl mx-auto px-6 section-block border-t border-white/[0.04]">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
      <div>
        <span class="section-label">Sound familiar?</span>
        <h2 class="section-heading mb-4">You built the app. Now you have to ship it.</h2>
        <p class="section-subheading mb-8">
          The work between the last commit and the App Store is scattered across tools that don't
          know about each other.
        </p>
        <ul class="chaos-list">
          {
            scatteredTools.map((tool) => (
              <li class="chaos-list__item">
                <span class={`chaos-list__icon chaos-list__icon--${tool.tone}`} aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d={tool.icon} />
                  </svg>
                </span>
                <span>{tool.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="slip-panel">
        <p class="slip-panel__headline">So things <span class="slip-panel__slip">slip.</span></p>
        <ul class="slip-alerts">
          {
            slipAlerts.map((alert) => (
              <li class="slip-alert">
                <span class={`slip-alert__icon slip-alert__icon--${alert.tone}`} aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d={alert.icon} />
                  </svg>
                </span>
                <span class="min-w-0">
                  <span class="slip-alert__title">{alert.title}</span>
                  <span class="slip-alert__body">{alert.body}</span>
                </span>
                <span class="slip-alert__time">now</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Solution + features -->
  <section class="max-w-6xl mx-auto px-6 section-block border-t border-white/[0.04]">
    <div class="max-w-3xl mx-auto text-center mb-16 md:mb-24">
      <span class="section-label">Meet LaunchBuddy</span>
      <h2 class="section-heading mb-5">Not Jira. Not a kanban clone.</h2>
      <p class="section-subheading mx-auto">
        One app for everything between
        <span class="status-chip">
          Build Succeeded
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" /><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        and
        <span class="status-chip">
          Ready for Sale
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" /><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        — built for solo developers and small studios.
      </p>
    </div>

    <div class="space-y-20 md:space-y-28">
      <!-- 1. Release planning -->
      <div class="feature-row">
        <div class="feature-row__copy">
          <div class="inline-flex items-center gap-2 text-accent-cyan font-mono text-xs uppercase tracking-wider mb-4">
            Release Planning
          </div>
          <h3 class="font-display font-bold text-2xl md:text-3xl text-text-primary mb-3 tracking-tight">
            Plan releases, not to-do lists.
          </h3>
          <p class="text-text-secondary leading-relaxed">
            Every fix and feature is tied to the version it ships in, with a status and a date. Always
            know what ships next — TestFlight or App Store.
          </p>
        </div>
        <div class="feature-row__media feature-image">
          <Image
            src={heroDashboard}
            alt="LaunchBuddy tasks and App Store release tracking dashboard"
            class="w-full aspect-video object-cover"
            widths={[640, 880, 1101]}
            sizes="(max-width: 768px) 100vw, 60vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- 2. Checklists -->
      <div class="feature-row feature-row--reverse">
        <div class="feature-row__copy">
          <div class="inline-flex items-center gap-2 text-emerald-400 font-mono text-xs uppercase tracking-wider mb-4">
            Release Checklists
          </div>
          <h3 class="font-display font-bold text-2xl md:text-3xl text-text-primary mb-3 tracking-tight">
            Nothing slips past submit.
          </h3>
          <p class="text-text-secondary leading-relaxed">
            Reusable checklists for screenshots, privacy labels, What's New, and every step of App
            Review — added to each release automatically, so nothing lives in your head.
          </p>
          <p class="mt-4">
            <a href="/checklist/" class="text-sm text-accent-cyan font-medium no-underline hover:text-accent-blue transition-colors">
              Get the free App Launch Checklist PDF →
            </a>
          </p>
        </div>
        <div class="feature-row__media feature-image">
          <Image
            src={checklists}
            alt="LaunchBuddy App Store submission checklists"
            class="w-full aspect-video object-cover"
            widths={[640, 1728, 3456]}
            sizes="(max-width: 768px) 100vw, 60vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- 3. App Store Connect -->
      <div class="feature-row">
        <div class="feature-row__copy">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-accent-blue font-mono text-xs uppercase tracking-wider">App Store Connect</span>
            <ProBadge />
          </div>
          <h3 class="font-display font-bold text-2xl md:text-3xl text-text-primary mb-3 tracking-tight">
            No more tab-hopping.
          </h3>
          <p class="text-text-secondary leading-relaxed">
            Read and reply to reviews, check your analytics, and push release notes to App Store
            Connect without leaving LaunchBuddy. Connect your API key once.
          </p>
        </div>
        <div class="feature-row__media feature-image">
          <Image
            src={reviews}
            alt="LaunchBuddy App Store Connect reviews inbox and reply workflow"
            class="w-full aspect-video object-cover"
            widths={[640, 1200, 2400]}
            sizes="(max-width: 768px) 100vw, 60vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- 4. AI -->
      <div class="feature-row feature-row--reverse">
        <div class="feature-row__copy">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-accent-violet font-mono text-xs uppercase tracking-wider">LaunchBuddy AI</span>
            <ProBadge />
          </div>
          <h3 class="font-display font-bold text-2xl md:text-3xl text-text-primary mb-3 tracking-tight">
            AI that knows your apps.
          </h3>
          <p class="text-text-secondary leading-relaxed">
            Ask about reviews, backlog, and releases. It drafts release notes and review replies and
            proposes changes — and nothing happens until you approve.
          </p>
        </div>
        <div class="feature-row__media feature-image">
          <Image
            src={aiChat}
            alt="LaunchBuddy AI app chat and idea chat for iOS developers"
            class="w-full aspect-video object-cover"
            widths={[640, 1200, 2400]}
            sizes="(max-width: 768px) 100vw, 60vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- 5. MCP -->
      <div class="feature-row">
        <div class="feature-row__copy">
          <div class="inline-flex items-center gap-2 text-accent-cyan font-mono text-xs uppercase tracking-wider mb-4">
            MCP Server for Mac
          </div>
          <h3 class="font-display font-bold text-2xl md:text-3xl text-text-primary mb-3 tracking-tight">
            Your agent knows the plan.
          </h3>
          <p class="text-text-secondary leading-relaxed">
            Connect Cursor, Claude Code, or Codex to LaunchBuddy's local MCP server. Agents read your
            releases, tasks, and checklists — and every change waits for your OK.
          </p>
          <p class="text-sm text-text-muted mt-4">
            Read tools are free. Write tools need Pro and always go through approval.
          </p>
        </div>
        <div class="feature-row__media">
          <AgentTerminalPreview />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-20 md:mt-28">
      <div class="glass-card glass-card--static p-6 md:p-8 flex flex-col">
        <div class="inline-flex items-center gap-2 text-accent-violet font-mono text-xs uppercase tracking-wider mb-4">
          iCloud Sync
        </div>
        <h3 class="font-display font-bold text-xl md:text-2xl text-text-primary mb-3">
          iPhone, iPad &amp; Mac. Always in sync.
        </h3>
        <p class="text-text-secondary leading-relaxed mb-6">
          Plan at your Mac, reply to a review from your iPhone, pick up exactly where you left off.
          Your private iCloud keeps every project current.
        </p>
        <div class="feature-image mt-auto">
          <Image
            src={crossPlatformSync}
            alt="LaunchBuddy sync between iPhone and Mac"
            class="w-full aspect-video object-cover"
            widths={[640, 1080]}
            sizes="(max-width: 768px) 100vw, 40vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="glass-card glass-card--static p-6 md:p-8 flex flex-col">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-accent-blue font-mono text-xs uppercase tracking-wider">ASO &amp; Notes</span>
          <ProBadge />
        </div>
        <h3 class="font-display font-bold text-xl md:text-2xl text-text-primary mb-3">
          Ship smarter with experiments &amp; notes.
        </h3>
        <p class="text-text-secondary leading-relaxed mb-6">
          Track icon, screenshot, and copy tests per app with baseline vs. experiment metrics. Keep
          product and marketing notes attached to each project.
        </p>
        <div class="feature-image mt-auto">
          <Image
            src={experiments}
            alt="LaunchBuddy ASO experiments tracking for App Store optimization"
            class="w-full aspect-video object-cover"
            widths={[640, 1200]}
            sizes="(max-width: 768px) 100vw, 40vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof -->
  <section class="max-w-6xl mx-auto px-6 section-block border-t border-white/[0.04]">
    <div class="text-center mb-14">
      <span class="section-label">Loved by indie devs</span>
      <h2 class="mb-5">
        <span class="rating-block__number block">{USER_COUNT}</span>
        <span class="section-heading block">developers use LaunchBuddy</span>
      </h2>
      <a
        href={APP_STORE_REVIEWS_URL}
        class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 no-underline group"
        rel="noopener noreferrer"
      >
        <StarRating rating={4.8} />
        <span class="text-text-secondary group-hover:text-accent-blue transition-colors">
          {APP_STORE_RATING} on the App Store · {APP_STORE_REVIEW_COUNT} reviews →
        </span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="glass-card glass-card--static p-6">
        <StarRating rating={5} />
        <p class="text-text-secondary mt-4 mb-6 leading-relaxed">
          "This is a great app. I use it for my iOS/Mac development to keep track of version &amp;
          release documentation, bug fixes and enhancements."
        </p>
        <div class="flex items-center gap-3">
          <div class="avatar">MB</div>
          <div>
            <p class="font-display font-semibold text-sm text-text-primary">
              <a href={APP_STORE_REVIEWS_URL} class="no-underline hover:text-accent-blue transition-colors" rel="noopener noreferrer">Maarten B.</a>
            </p>
            <p class="text-xs text-text-muted">Release tracking · App Store review</p>
          </div>
        </div>
      </div>

      <div class="glass-card glass-card--static p-6">
        <StarRating rating={5} />
        <p class="text-text-secondary mt-4 mb-6 leading-relaxed">
          "LaunchBuddy is a great tool to help you organize your projects, keep on top of goals,
          and actually work towards shipping something on the App Store. Hard recommend."
        </p>
        <div class="flex items-center gap-3">
          <div class="avatar">★</div>
          <div>
            <p class="font-display font-semibold text-sm text-text-primary">
              <a href={APP_STORE_REVIEWS_URL} class="no-underline hover:text-accent-blue transition-colors" rel="noopener noreferrer">App Store Review</a>
            </p>
            <p class="text-xs text-text-muted">Shipping workflow · Verified purchase</p>
          </div>
        </div>
      </div>

      <div class="glass-card glass-card--static p-6">
        <StarRating rating={5} />
        <p class="text-text-secondary mt-4 mb-6 leading-relaxed">
          "This tool makes it super easy to track and plan what you're developing, and syncs
          between phone and Mac."
        </p>
        <div class="flex items-center gap-3">
          <div class="avatar">★</div>
          <div>
            <p class="font-display font-semibold text-sm text-text-primary">
              <a href={APP_STORE_REVIEWS_URL} class="no-underline hover:text-accent-blue transition-colors" rel="noopener noreferrer">App Store Review</a>
            </p>
            <p class="text-xs text-text-muted">Cross-device sync · Verified purchase</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pro section -->
  <section id="pro-features" class="max-w-6xl mx-auto px-6 section-block scroll-mt-24 border-t border-white/[0.04]">
    <div class="mb-14 max-w-2xl">
      <span class="section-label">LaunchBuddy Pro</span>
      <h2 class="section-heading mb-4">Start free. Upgrade when you ship more.</h2>
      <p class="section-subheading">
        Free gets you started on a side project. Pro unlocks App Store Connect, AI, agent write
        tools, and unlimited apps for {PRO_MONTHLY_PRICE}/mo — less than a coffee.
      </p>
    </div>

    <FeatureComparisonTable />

    <p class="text-sm text-text-muted mt-8">
      One subscription covers iPhone, iPad, and Mac at {PRO_MONTHLY_PRICE}/mo or {PRO_YEARLY_PRICE}/yr.
      Feature availability depends on the platform.
    </p>
  </section>

  <!-- Mid CTA -->
  <section class="max-w-6xl mx-auto px-6 section-block">
    <div class="cta-banner relative z-10">
      <div class="flex flex-col items-center text-center">
        <h2 class="cta-banner__headline mb-5">
          Your next release deserves better than a spreadsheet
        </h2>
        <p class="text-text-secondary text-lg mb-8 max-w-lg">
          Start free on your side project. Upgrade to Pro when ASC, AI, and unlimited apps become
          part of your shipping rhythm.
        </p>
        <CTAStack size="lg" showBadge showPricing />
        <a href="#pro-features" class="text-sm text-text-muted hover:text-accent-blue no-underline mt-6 transition-colors">
          Compare free vs. Pro →
        </a>
      </div>
    </div>
  </section>

  <!-- Blog strip -->
  <section class="max-w-6xl mx-auto px-6 section-block border-t border-white/[0.04]">
    <div class="mb-12 max-w-2xl">
      <span class="section-label">Learn how to ship</span>
      <h2 class="section-heading mb-4">Guides for indie iOS developers</h2>
      <p class="section-subheading">
        Deep dives on App Store Connect, AI workflows, and release management.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        HOMEPAGE_BLOG_POSTS.map((post) => (
          <a href={`/blog/${post.slug}/`} class="glass-card glass-card--interactive p-6 no-underline block group">
            <h3 class="font-display font-semibold text-text-primary mb-2 group-hover:text-accent-blue transition-colors">
              {post.title}
            </h3>
            <p class="text-sm text-text-secondary mb-4 leading-relaxed">{post.description}</p>
            <span class="text-sm text-accent-cyan font-medium">Read guide →</span>
          </a>
        ))
      }
    </div>

    <p class="text-center mt-8">
      <a href="/blog/" class="text-sm text-text-muted hover:text-accent-blue no-underline transition-colors">
        Browse all guides →
      </a>
    </p>
  </section>

  <!-- FAQ -->
  <section class="max-w-6xl mx-auto px-6 section-block">
    <div class="mb-12">
      <span class="section-label">FAQ</span>
      <h2 class="section-heading">Common questions</h2>
    </div>

    <div class="max-w-3xl mx-auto space-y-3">
      {
        FAQ_ITEMS.map((item) => (
          <details class="faq-item group">
            <summary class="flex justify-between items-center cursor-pointer p-5 md:p-6 text-text-primary font-display font-semibold">
              <span>{item.question}</span>
              <svg class="w-5 h-5 text-text-muted transition-transform group-open:rotate-180 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 md:px-6 pb-5 md:pb-6 text-text-secondary leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Final CTA -->
  <section class="max-w-6xl mx-auto px-6 pb-16 md:pb-24">
    <div class="text-center">
      <h2 class="cta-banner__headline mb-6">Ready to start shipping?</h2>
      <CTAStack size="lg" showBadge showProTeaser />
      <p class="text-xs text-text-muted mt-4">
        Free for {FREE_TIER_APPS} apps &amp; {FREE_TIER_RELEASES} releases · Pro from {PRO_MONTHLY_PRICE}/mo or {PRO_YEARLY_PRICE}/yr
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
