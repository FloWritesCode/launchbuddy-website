---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import PricingTeaser from '../components/PricingTeaser.astro';
import StarRating from '../components/StarRating.astro';
import heroDashboard from '../assets/hero-dashboard.png';
import crossPlatformSync from '../assets/cross-platform-sync.png';
import checklists from '../assets/checklists.png';
import {
  APP_STORE_REVIEWS_URL,
  APP_STORE_RATING,
  APP_STORE_REVIEW_COUNT,
  DEMO_VIDEO_MP4,
  DEMO_VIDEO_WEBM,
  PRO_MONTHLY_PRICE,
  PRO_YEARLY_PRICE,
  USER_COUNT,
} from '../lib/site';

const heroLcp = await getImage({ src: heroDashboard, width: 880, format: 'webp' });
---

<BaseLayout path="/" preloadImage={heroLcp.src}>
  <div class="container pt-8 md:pt-12 mx-auto flex flex-wrap flex-col md:flex-row items-center">
    <!-- Hero -->
    <div class="flex flex-col w-full xl:w-2/5 justify-center lg:items-start overflow-y-hidden">
      <h1 class="my-4 text-3xl md:text-5xl text-white opacity-75 font-bold leading-tight text-center md:text-left">
        Stop losing track of your
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-200 via-blue-500 to-blue-300">
          Xcode
        </span>
        projects!
      </h1>
      <p class="leading-normal text-base md:text-2xl mb-4 text-center md:text-left">
        Join {USER_COUNT} developers who are already shipping faster with LaunchBuddy!
      </p>

      <div class="w-full flex flex-col items-center md:items-start gap-3 pb-8 fade-in">
        <AppStoreBadge size="md" />
        <PricingTeaser />
      </div>
    </div>

    <div class="w-full xl:w-3/5 p-6 md:p-12 overflow-hidden">
      <div
        class="mx-auto w-full md:w-4/5 rounded-xl overflow-hidden shadow-2xl transform -rotate-3 transition hover:scale-105 duration-700 ease-in-out hover:rotate-0 ring-1 ring-white/10"
      >
        <video
          class="w-full aspect-video object-cover bg-gray-900"
          autoplay
          muted
          loop
          playsinline
          poster={heroLcp.src}
          aria-label="LaunchBuddy app demo showing release planning and App Store checklists"
        >
          <source src={DEMO_VIDEO_WEBM} type="video/webm" />
          <source src={DEMO_VIDEO_MP4} type="video/mp4" />
          <img
            src={heroLcp.src}
            alt="LaunchBuddy iOS app release manager dashboard on Mac"
            class="w-full"
            width="880"
            height="495"
          />
        </video>
      </div>
    </div>

    <!-- SEO intro -->
    <div class="w-full py-12 px-4">
      <div class="max-w-4xl mx-auto text-center md:text-left">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
          The App Release Manager Built for Indie iOS Developers
        </h2>
        <p class="text-lg text-white opacity-90 leading-relaxed">
          LaunchBuddy is project management for indie developers who ship apps to the App Store — not enterprise
          backlogs. Track Xcode projects, plan releases, and run App Store submission checklists from iPhone and Mac.
          A simple side project tracker trusted by {USER_COUNT} developers.
        </p>
      </div>
    </div>

    <!-- Audience -->
    <div class="w-full py-16">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Built for Indie iOS Developers</h2>
        <p class="text-xl text-white leading-relaxed opacity-90">
          LaunchBuddy is built for solo developers, small indie studios, and freelancers managing App Store
          submissions. Whether you need an Xcode project manager for your day job and side projects, or a lightweight
          alternative to heavy tools like Linear or Jira, LaunchBuddy keeps indie dev productivity focused on
          shipping — not admin.
        </p>
      </div>
    </div>

    <!-- Features -->
    <div class="w-full pt-8 pb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-4">
        iOS App Release Management Features
      </h2>
      <p class="text-center text-white opacity-90 max-w-3xl mx-auto px-4 mb-12">
        Everything you need to track tasks, ship releases, and stay on top of App Store submissions.
      </p>
      <div class="max-w-6xl mx-auto space-y-16 px-4">
        <div class="bg-gray-900/75 p-8 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="w-full md:w-2/5">
              <h3 class="text-2xl font-bold text-white mb-4">
                Track Tasks and App Store Releases in One Place
              </h3>
              <p class="text-white leading-relaxed">
                LaunchBuddy works as your iOS app release manager, keeping every task tied to a version you plan to
                ship. Organize bug fixes, features, and polish into releases so you always know what ships next.
                Whether you are preparing an App Store submission or a TestFlight build, your release plan stays
                visible. Perfect as a side project tracker when you juggle multiple Xcode projects at once.
              </p>
            </div>
            <div class="w-full md:w-3/5 h-96 bg-gray-800 rounded-lg overflow-hidden">
              <Image
                src={heroDashboard}
                alt="LaunchBuddy tasks and App Store release tracking dashboard"
                class="w-full h-full object-cover"
                widths={[640, 880, 1101]}
                sizes="(max-width: 768px) 100vw, 60vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <div class="bg-gray-900/75 p-8 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex flex-col md:flex-row-reverse items-center gap-12">
            <div class="w-full md:w-2/5">
              <h3 class="text-2xl font-bold text-white mb-4">Cross-Platform Sync for iPhone and Mac</h3>
              <p class="text-white leading-relaxed">
                Seamlessly sync your Xcode projects between iOS and macOS via iCloud. Review tasks on your iPhone,
                update progress at your Mac, and pick up exactly where you left off. LaunchBuddy is built for indie
                developers who work across devices without losing context. Your iOS developer task manager stays
                current whether you are at your desk or on the go.
              </p>
            </div>
            <div class="w-full md:w-3/5 h-96 bg-gray-800 rounded-lg overflow-hidden">
              <Image
                src={crossPlatformSync}
                alt="LaunchBuddy Xcode project sync between iPhone and Mac"
                class="w-full h-full object-cover"
                widths={[640, 1080, 2160]}
                sizes="(max-width: 768px) 100vw, 60vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <div class="bg-gray-900/75 p-8 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="w-full md:w-2/5">
              <h3 class="text-2xl font-bold text-white mb-4">Smart Checklists for App Store Submissions</h3>
              <p class="text-white leading-relaxed">
                Create reusable checklists that automatically add tasks to every release. Standardize screenshots,
                metadata, TestFlight builds, and review notes so nothing gets forgotten before submission.
                LaunchBuddy replaces scattered notes with a simple App Store submission tracker built into your
                workflow. Spend less time remembering steps and more time shipping your next version.
              </p>
            </div>
            <div class="w-full md:w-3/5 h-96 bg-gray-800 rounded-lg overflow-hidden">
              <Image
                src={checklists}
                alt="LaunchBuddy App Store submission checklists for iOS releases"
                class="w-full h-full object-cover"
                widths={[640, 1728, 3456]}
                sizes="(max-width: 768px) 100vw, 60vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonials -->
    <div class="w-full pt-16 pb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12">What Our Users Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
        <div class="bg-gray-900/75 p-6 rounded-lg transform hover:scale-105 transition duration-300">
          <StarRating rating={5} />
          <p class="text-white mb-4 mt-4">
            "This is a great app. I use it for my iOS/Mac development to keep track of version &amp; release
            documentation, bug fixes and enhancements."
          </p>
          <div class="flex items-center">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 flex items-center justify-center"
            >
              <span class="text-white font-bold">MB</span>
            </div>
            <div class="ml-3">
              <p class="text-white font-semibold">
                <a
                  href={APP_STORE_REVIEWS_URL}
                  class="text-white no-underline hover:text-blue-300"
                  rel="noopener noreferrer"
                >
                  Maarten B.
                </a>
              </p>
              <p class="text-gray-400 text-sm">iOS Developer · App Store review</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900/75 p-6 rounded-lg transform hover:scale-105 transition duration-300">
          <StarRating rating={5} />
          <p class="text-white mb-4 mt-4">
            "LaunchBuddy is a great tool to help you organize your projects, keep on top of goals, and actually work
            towards shipping something on the App Store. Hard recommend."
          </p>
          <div class="flex items-center">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 flex items-center justify-center"
            >
              <span class="text-white font-bold">★</span>
            </div>
            <div class="ml-3">
              <p class="text-white font-semibold">
                <a
                  href={APP_STORE_REVIEWS_URL}
                  class="text-white no-underline hover:text-blue-300"
                  rel="noopener noreferrer"
                >
                  Verified App Store Review
                </a>
              </p>
              <p class="text-gray-400 text-sm">Indie iOS Developer</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900/75 p-6 rounded-lg transform hover:scale-105 transition duration-300">
          <StarRating rating={5} />
          <p class="text-white mb-4 mt-4">
            "I love LaunchBuddy. I've been using it for several years at this point."
          </p>
          <div class="flex items-center">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 flex items-center justify-center"
            >
              <span class="text-white font-bold">MC</span>
            </div>
            <div class="ml-3">
              <p class="text-white font-semibold">
                <a
                  href="https://mikaelacaron.com/"
                  class="text-white no-underline hover:text-blue-300"
                  rel="noopener noreferrer"
                >
                  Mikaela Caron
                </a>
              </p>
              <p class="text-gray-400 text-sm">
                iOS Developer ·
                <a
                  href="https://podcasts.apple.com/us/podcast/swift-over-coffee/id1435076502"
                  class="text-gray-400 no-underline hover:text-blue-300"
                  rel="noopener noreferrer"
                >
                  Swift over Coffee
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Rating -->
    <div class="w-full py-16">
      <div class="max-w-2xl mx-auto text-center px-4">
        <a
          href={APP_STORE_REVIEWS_URL}
          class="group inline-block no-underline hover:scale-105 transition-transform duration-300"
          rel="noopener noreferrer"
        >
          <div class="text-8xl font-bold text-white mb-6 group-hover:text-blue-200 transition-colors">
            {APP_STORE_RATING}
          </div>
          <div class="flex justify-center items-center mb-4">
            <StarRating rating={4.8} size="lg" />
          </div>
          <p class="text-xl text-white group-hover:text-blue-200 transition-colors">
            from {APP_STORE_REVIEW_COUNT} App Store reviews
          </p>
          <p class="text-sm text-blue-300 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
            Read all reviews →
          </p>
        </a>
      </div>
    </div>

    <!-- Mid-page CTA (after social proof) -->
    <div class="w-full py-16">
      <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to Ship Your Next Project?</h2>
        <p class="text-xl text-white mb-4">
          Join thousands of developers who are already using LaunchBuddy to manage their projects
        </p>
        <PricingTeaser class="mb-8" />
        <div class="flex justify-center">
          <AppStoreBadge size="lg" />
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <div class="w-full py-16">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-gray-800/50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Is LaunchBuddy free?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, LaunchBuddy is free to download and use for up to 2 apps. Pro features — unlimited apps, custom
              checklists, and more — start at {PRO_MONTHLY_PRICE}/month or {PRO_YEARLY_PRICE}/year.
            </div>
          </details>

          <details class="group bg-gray-800/50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Is the iOS app included if I subscribe on the Mac?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, your subscription covers both the macOS and iOS versions of LaunchBuddy.
            </div>
          </details>

          <details class="group bg-gray-800/50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Can I suggest features?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, you can suggest features via the roadmap directly in LaunchBuddy.
            </div>
          </details>

          <details class="group bg-gray-800/50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Does my data sync between iOS and macOS?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, all your data syncs seamlessly between devices via iCloud.
            </div>
          </details>
        </div>
      </div>
    </div>

    <!-- Final CTA -->
    <div class="mx-auto md:pt-16">
      <p class="text-blue-400 font-bold pb-4 text-center">Download LaunchBuddy:</p>
      <PricingTeaser class="text-center pb-6" />
      <div class="w-full flex justify-center pb-24 lg:pb-0 fade-in">
        <AppStoreBadge size="lg" />
      </div>
    </div>

    <Footer />
  </div>
</BaseLayout>
