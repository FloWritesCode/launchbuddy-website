---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout path="/">
  <div class="container pt-24 md:pt-36 mx-auto flex flex-wrap flex-col md:flex-row items-center">
    <div class="flex flex-col w-full xl:w-2/5 justify-center lg:items-start overflow-y-hidden">
      <h1 class="my-4 text-3xl md:text-5xl text-white opacity-75 font-bold leading-tight text-center md:text-left">
        Stop losing track of your
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-200 via-blue-500 to-blue-300">
          Xcode
        </span>
        projects!
      </h1>
      <p class="leading-normal text-base md:text-2xl mb-8 text-center md:text-left">
        Join 20,000+ developers who are already shipping faster with LaunchBuddy!
      </p>

      <div class="w-full justify-center md:justify-start pb-8 fade-in">
        <a href="https://apple.co/3iFcjjW">
          <img
            src="/App Store.svg"
            class="h-16 transform hover:scale-110 duration-300 ease-in-out"
            alt="Download LaunchBuddy on the App Store"
          />
        </a>
      </div>
    </div>

    <div class="w-full xl:w-3/5 p-12 overflow-hidden">
      <img
        class="mx-auto w-full md:w-4/5 rounded transform -rotate-6 transition hover:scale-105 duration-700 ease-in-out hover:rotate-6"
        src="/image 7.png"
        alt="LaunchBuddy app screenshot"
      />
    </div>

    <div class="w-full py-16">
      <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to Ship Your Next Project?</h2>
        <p class="text-xl text-white mb-8">
          Join thousands of developers who are already using LaunchBuddy to manage their projects
        </p>
        <div class="flex justify-center">
          <a href="https://apple.co/3iFcjjW" class="transform hover:scale-105 duration-300 ease-in-out">
            <img src="/App Store.svg" class="h-24" alt="Download on the App Store" />
          </a>
        </div>
      </div>
    </div>

    <div class="w-full pt-16 pb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12">What Our Users Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
        <div class="bg-gray-900 bg-opacity-75 p-6 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex items-center mb-4">
            {
              Array.from({ length: 5 }).map(() => (
                <div class="text-yellow-400 ml-1 first:ml-0">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </div>
              ))
            }
          </div>
          <p class="text-white mb-4">"It's a great app. It's easy, quick and it keeps me organized."</p>
          <div class="flex items-center">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 flex items-center justify-center"
            >
              <span class="text-white font-bold">MB</span>
            </div>
            <div class="ml-3">
              <p class="text-white font-semibold">Maarten B.</p>
              <p class="text-gray-400 text-sm">iOS Developer</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900 bg-opacity-75 p-6 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex items-center mb-4">
            {
              Array.from({ length: 5 }).map(() => (
                <div class="text-yellow-400 ml-1 first:ml-0">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </div>
              ))
            }
          </div>
          <p class="text-white mb-4">
            "LaunchBuddy is a great tool to have in your arsenal as a developer. Helps keep track of the various
            stages, and the iOS app enables you to keep track of things when away from your Mac."
          </p>
          <div class="flex items-center">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 flex items-center justify-center"
            >
              <span class="text-white font-bold">AN</span>
            </div>
            <div class="ml-3">
              <p class="text-white font-semibold">Anonymous</p>
              <p class="text-gray-400 text-sm">LaunchBuddy User</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900 bg-opacity-75 p-6 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex items-center mb-4">
            {
              Array.from({ length: 5 }).map(() => (
                <div class="text-yellow-400 ml-1 first:ml-0">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </div>
              ))
            }
          </div>
          <p class="text-white mb-4">"I love LaunchBuddy. I've been using it for several years at this point."</p>
          <div class="flex items-center">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-r from-green-400 via-pink-500 to-purple-500 flex items-center justify-center"
            >
              <span class="text-white font-bold">MC</span>
            </div>
            <div class="ml-3">
              <p class="text-white font-semibold">Mikaela C.</p>
              <p class="text-gray-400 text-sm">iOS Developer & Podcast Host</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="w-full py-16">
      <div class="max-w-2xl mx-auto text-center px-4">
        <div class="text-8xl font-bold text-white mb-6">4.7</div>
        <div class="flex justify-center items-center mb-4">
          {
            Array.from({ length: 4 }).map(() => (
              <div class="text-yellow-400 ml-2 first:ml-0">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              </div>
            ))
          }
          <div class="text-yellow-400 ml-2 relative">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <div
              class="absolute inset-0 bg-transparent"
              style="clip-path: polygon(70% 0%, 100% 0%, 100% 100%, 70% 100%)"
            >
            </div>
          </div>
        </div>
        <p class="text-xl text-white">from developers like you</p>
      </div>
    </div>

    <div class="w-full pt-24 pb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12">
        Powerful Features for Project Management
      </h2>
      <div class="max-w-6xl mx-auto space-y-16 px-4">
        <div class="bg-gray-900 bg-opacity-75 p-8 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="w-full md:w-2/5">
              <h3 class="text-2xl font-bold text-white mb-4">Tasks & Releases</h3>
              <p class="text-white">
                Easily manage your tasks and organize them into releases. Keep track of what needs to be done and when
                it needs to be shipped.
              </p>
            </div>
            <div class="w-full md:w-3/5 h-96 bg-gray-800 rounded-lg overflow-hidden">
              <img
                src="/image 7.png"
                alt="Tasks & Releases feature screenshot"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="bg-gray-900 bg-opacity-75 p-8 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex flex-col md:flex-row-reverse items-center gap-12">
            <div class="w-full md:w-2/5">
              <h3 class="text-2xl font-bold text-white mb-4">Cross-Platform Sync</h3>
              <p class="text-white">
                Seamlessly sync your projects between iOS and macOS. Work on your projects wherever you are, and your
                changes are always up to date.
              </p>
            </div>
            <div class="w-full md:w-3/5 h-96 bg-gray-800 rounded-lg overflow-hidden">
              <img src="/images/iPhone and Mac.png" alt="Mac and iOS screenshot" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

        <div class="bg-gray-900 bg-opacity-75 p-8 rounded-lg transform hover:scale-105 transition duration-300">
          <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="w-full md:w-2/5">
              <h3 class="text-2xl font-bold text-white mb-4">Smart Checklists</h3>
              <p class="text-white">
                Create reusable checklists that automatically add tasks to your releases. Save time and ensure nothing
                gets forgotten.
              </p>
            </div>
            <div class="w-full md:w-3/5 h-96 bg-gray-800 rounded-lg overflow-hidden">
              <img src="/images/checklists.png" alt="Checklists for repeating tasks" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="w-full py-16">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-gray-800 bg-opacity-50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Is LaunchBuddy free?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, LaunchBuddy is free to download and use. There are additional pro features available via
              subscription.
            </div>
          </details>

          <details class="group bg-gray-800 bg-opacity-50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Is the iOS app included if I subscribe on the Mac?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, your subscription covers both the macOS and iOS versions of LaunchBuddy.
            </div>
          </details>

          <details class="group bg-gray-800 bg-opacity-50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Can I suggest features?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, you can suggest features via the roadmap directly in LaunchBuddy.
            </div>
          </details>

          <details class="group bg-gray-800 bg-opacity-50 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-6 text-white font-semibold">
              <span>Does my data sync between iOS and macOS?</span>
              <span class="transition group-open:rotate-180">
                <svg
                  fill="none"
                  height="24"
                  shape-rendering="geometricPrecision"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  width="24"><path d="M6 9l6 6 6-6"></path></svg
                >
              </span>
            </summary>
            <div class="px-6 pb-6 text-white">
              Yes, all your data syncs seamlessly between devices via iCloud.
            </div>
          </details>
        </div>
      </div>
    </div>

    <div class="mx-auto md:pt-16">
      <p class="text-blue-400 font-bold pb-8 lg:pb-6 text-center">Download LaunchBuddy:</p>
      <div class="w-full justify-center md:justify-center pb-24 lg:pb-0 fade-in">
        <a href="https://apple.co/3iFcjjW">
          <img
            src="/App Store.svg"
            class="h-24 transform hover:scale-110 duration-300 ease-in-out"
            alt="Download on the App Store"
          />
        </a>
      </div>
    </div>

    <Footer />
  </div>
</BaseLayout>
