---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ChaosToOrder from '../components/home/ChaosToOrder.astro';
import ReleaseTrack from '../components/home/ReleaseTrack.astro';
import Bento from '../components/home/Bento.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Pricing from '../components/home/Pricing.astro';
import Faq from '../components/home/Faq.astro';
import BlogStrip from '../components/home/BlogStrip.astro';
import FinalCta from '../components/home/FinalCta.astro';
import vslPosterAsset from '../assets/vsl-poster.jpg';
import '../styles/home.css';
import {
  APP_STORE_RATING,
  APP_STORE_REVIEW_COUNT,
  APP_STORE_URL,
  DEFAULT_DESCRIPTION,
  FAQ_ITEMS,
  VSL_DESCRIPTION,
  VSL_DURATION_ISO,
  VSL_TITLE,
  VSL_UPLOAD_DATE,
  VSL_YOUTUBE_ID,
} from '../lib/site';

const vslPoster = await getImage({ src: vslPosterAsset, width: 1280, format: 'webp' });

const homepageJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LaunchBuddy',
    description: DEFAULT_DESCRIPTION,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'iOS, macOS',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: APP_STORE_RATING,
      bestRating: '5',
      ratingCount: String(APP_STORE_REVIEW_COUNT),
    },
    url: 'https://launchbuddy.app',
    downloadUrl: APP_STORE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: VSL_TITLE,
    description: VSL_DESCRIPTION,
    thumbnailUrl: `https://i.ytimg.com/vi/${VSL_YOUTUBE_ID}/maxresdefault.jpg`,
    uploadDate: VSL_UPLOAD_DATE,
    duration: VSL_DURATION_ISO,
    embedUrl: `https://www.youtube.com/embed/${VSL_YOUTUBE_ID}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_ITEMS.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout path="/" preloadImage={vslPoster.src} jsonLd={homepageJsonLd}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
  </Fragment>

  <Hero poster={vslPoster.src} />
  <ChaosToOrder />
  <ReleaseTrack />
  <Bento />
  <Testimonials />
  <Pricing />
  <Faq />
  <BlogStrip />
  <FinalCta />
  <Footer />
</BaseLayout>
