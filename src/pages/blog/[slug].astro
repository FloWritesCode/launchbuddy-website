---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import CTAStack from '../../components/CTAStack.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const canonicalUrl = new URL(path, Astro.site).href;
---

<BaseLayout
  title={`${post.data.title} | LaunchBuddy Blog`}
  description={post.data.description}
  path={path}
  ogType="article"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      '@type': 'Person',
      name: 'Florian Schweizer',
    },
    publisher: {
      '@type': 'Organization',
      name: 'LaunchBuddy',
      url: 'https://launchbuddy.app',
    },
    mainEntityOfPage: canonicalUrl,
  }}
>
  <article class="max-w-3xl mx-auto px-6 pt-12 md:pt-16 pb-8">
    <a class="text-sm text-accent-blue hover:text-accent-cyan no-underline font-medium transition-colors" href="/blog/">← Back to blog</a>
    <h1 class="font-display font-bold text-3xl md:text-5xl text-text-primary my-6 leading-tight">{post.data.title}</h1>
    <p class="text-text-muted text-sm mb-8 font-mono">
      {post.data.pubDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </p>

    <div class="blog-content text-text-secondary space-y-4 leading-relaxed">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-white/5">
      <CTAStack size="md" align="start" showBadge showPricing />
    </div>
  </article>

  <Footer />
</BaseLayout>

<style>
  .blog-content :global(a) {
    color: var(--color-accent-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-content :global(a:hover) {
    color: var(--color-accent-cyan);
  }

  .blog-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-content :global(strong) {
    color: var(--color-text-primary);
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.35rem;
  }

  .blog-content :global(ul) {
    list-style: disc;
  }

  .blog-content :global(ol) {
    list-style: decimal;
  }

  .blog-content :global(li::marker) {
    color: var(--color-brand-light);
  }

  .blog-content :global(blockquote) {
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 2px solid var(--color-brand);
    color: var(--color-text-primary);
  }

  .blog-content :global(code) {
    padding: 0.1rem 0.35rem;
    border-radius: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-text-primary);
    background: rgb(255 255 255 / 0.06);
  }

  .blog-content :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.15rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
  }

  .blog-content :global(pre code) {
    padding: 0;
    background: none;
  }

  .blog-content :global(hr) {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .blog-content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .blog-content :global(figure) {
    margin: 1.5rem 0;
  }

  .blog-content :global(figure img) {
    margin: 0;
  }

  .blog-content :global(figcaption) {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
